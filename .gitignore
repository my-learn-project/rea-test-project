# 本机工具链、演示身份和敏感开发数据
/.tools/
/.local/
/.secrets/
.env
.env.*
!.env.example
!.env.template

# Rust 构建产物（应用项目的 Cargo.lock 应提交）
/target/
*.pdb
*.ilk
*.dSYM/

# CMake / Qt 构建和分发目录
/build/
/dist/
/out/
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
/Testing/
/compile_commands.json
CMakeUserPresets.json
CMakeLists.txt.user*
*.pro.user*

# 个人 IDE 状态；可共享的 .vscode 配置仍可提交
/.vs/
/.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# 本机发行身份及代码签名材料
*.private.json
*.private.pem
*.key
*.dpapi
*.passphrase.txt
*.pfx
*.p12
demo-card.txt
invalid-card.txt

# 项目所有者明确公开的演示身份，只放行指定三件套与说明
/demo/keys/*
!/demo/keys/demo.private.json
!/demo/keys/demo.passphrase.txt
!/demo/keys/demo.public.hex
!/demo/keys/README.md

# 本机选择的验签公钥；CI 通过仓库变量注入，保留 .hex.example
/config/trusted-public-key.hex

# Python 辅助脚本缓存、虚拟环境及日志
__pycache__/
*.py[cod]
/.venv/
/venv/
.pytest_cache/
*.log

# macOS / Windows 系统文件
.DS_Store
.AppleDouble
._*
Thumbs.db
Desktop.ini
